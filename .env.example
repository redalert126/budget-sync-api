# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Matches docker-compose.yml
DATABASE_URL=postgres://budget:budget@localhost:5432/budget_dev
REDIS_URL=redis://localhost:6379

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Plaid sandbox credentials from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional locally. Errors are reported only when set.
SENTRY_DSN=
