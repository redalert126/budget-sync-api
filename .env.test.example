# Copy to .env.test to run integration tests locally against docker-compose Postgres.
# Run migrations on it first: DATABASE_URL=<value below> npm run migrate:up
NODE_ENV=test
LOG_LEVEL=silent
DATABASE_URL=postgres://budget:budget@localhost:5432/budget_test
REDIS_URL=redis://localhost:6379
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
